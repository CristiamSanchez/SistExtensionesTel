@model SistemaTelefonico.Models.TelefonosIndexViewModel

@* @model IEnumerable<SistemaTelefonico.Models.Telefono> *@

<!-- en cada vista -->
@{
    ViewData["Title"] = "Index";
    ViewData["BodyClass"] = "index-bg-page";
}

<h1 class="bg-secondary text-white p-3 rounded">Listado de Teléfonos</h1>

@* @if (User.IsInRole("Administrador"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">Nuevo Teléfono</a>
} *@

@if (User.IsInRole("Administrador"))
{
    <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addTelefonoModal">
        ➕ Nuevo Teléfono
    </button>
}

@if (Model.Telefonos == null || !Model.Telefonos.Any())
{
    <div class="alert alert-warning">No hay teléfonos registrados.</div>
}
else
{
        
        <div class="input-group mb-3" style="max-width:400px;">
        <span class="input-group-text bg-white">🔍</span>
        <input type="text" id="buscadorTelefonos" class="form-control"
               placeholder="Buscar por nombre o número..." autocomplete="off" />
        <button class="btn btn-outline-secondary" type="button" id="btnLimpiarBusqueda">✕ Limpiar</button>
    </div>
    <div id="sinResultados" class="alert alert-warning d-none">No se encontraron coincidencias.</div>

    <table id="tablaTelefonos" class="table table-striped table-hover">       
        <thead>
            <tr>
                <th>Dueño</th>
                <th>Número</th>
                <th>Descripción</th>
                <th>Fecha</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        @foreach (var item in Model.Telefonos)
        {
            <tr>
                <td>@item.NombreDueno</td>
                <td>@item.NumeroTelefono</td>
                <td>@item.Descripcion</td>
                <td>@item.FechaCreacion</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <button type="button" class="btn btn-sm btn-warning"
                            data-bs-toggle="modal" data-bs-target="#editTelefonoModal"
                            data-id="@item.Id"
                            data-nombre="@item.NombreDueno"
                            data-numero="@item.NumeroTelefono"
                            data-descripcion="@item.Descripcion">
                            Editar
                        </button>
                        <button type="button" class="btn btn-sm btn-danger"
                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                            data-id="@item.Id"
                            data-nombre="@item.NombreDueno">
                            Eliminar
                        </button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

        @if (User.IsInRole("Administrador"))
        {
            <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addTelefonoModal">
                ➕ Nuevo Teléfono
            </button>
        }
}

@if (User.IsInRole("Administrador"))
{


    // ── Confirmar eliminación ─────────────────────────────────────────────────

    <!-- Modal Confirmar Eliminación -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteConfirmLabel">Confirmar eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de que desea eliminar el registro de <strong id="deleteNombre"></strong>?</p>
                    <p class="text-muted small">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form id="formDelete" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Editar Teléfono -->
    <div class="modal fade" id="editTelefonoModal" tabindex="-1" aria-labelledby="editTelefonoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="editTelefonoLabel">Editar Teléfono</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formEditTelefono" asp-action="Edit" method="post">
                        <input type="hidden" id="editId" name="Id" />
                        <div id="editValidationSummary" class="text-danger mb-2"></div>

                        <div class="mb-3">
                            <label class="form-label">Nombre del responsable</label>
                            <input type="text" id="editNombreDueno" name="NombreDueno" class="form-control" />
                            <span id="editErrorNombreDueno" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Número telefónico</label>
                            <input type="text" id="editNumeroTelefono" name="NumeroTelefono" class="form-control" />
                            <span id="editErrorNumeroTelefono" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <input type="text" id="editDescripcion" name="Descripcion" class="form-control" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning" form="formEditTelefono">Guardar cambios</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Agregar Teléfono -->
    <div class="modal fade" id="addTelefonoModal" tabindex="-1" aria-labelledby="addTelefonoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addTelefonoLabel">Agregar Nuevo Teléfono</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <form id="formAddTelefono" asp-action="Create" method="post">
                        <div id="addValidationSummary" class="text-danger mb-2"></div>

                        <div class="mb-3">
                            <label class="form-label">Nombre del responsable</label>
                            <input asp-for="NuevoTelefono.NombreDueno" name="NombreDueno" class="form-control" />
                            <span id="addErrorNombreDueno" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Número telefónico</label>
                            <input asp-for="NuevoTelefono.NumeroTelefono" name="NumeroTelefono" class="form-control" />
                            <span id="addErrorNumeroTelefono" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <input asp-for="NuevoTelefono.Descripcion" name="Descripcion" class="form-control" />
                        </div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success" form="formAddTelefono">Guardar</button>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
<script>

    // ── Búsqueda en tiempo real ───────────────────────────────────────────────
    document.getElementById('buscadorTelefonos').addEventListener('input', function () {
        filtrarTabla(this.value.trim());
    });

    document.getElementById('btnLimpiarBusqueda').addEventListener('click', function () {
        document.getElementById('buscadorTelefonos').value = '';
        filtrarTabla('');
    });

    function filtrarTabla(texto) {
        var termino = texto.toLowerCase();
        var filas = document.querySelectorAll('#tablaTelefonos tbody tr');
        var visibles = 0;

        filas.forEach(function (fila) {
            var nombre = fila.cells[0].textContent.toLowerCase();
            var numero = fila.cells[1].textContent.toLowerCase();
            var coincide = nombre.includes(termino) || numero.includes(termino);
            fila.style.display = coincide ? '' : 'none';
            if (coincide) visibles++;
        });

        document.getElementById('sinResultados').classList.toggle('d-none', visibles > 0);
    }


    // ── Confirmar eliminación ─────────────────────────────────────────────────
    var deleteModal = document.getElementById('deleteConfirmModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('deleteNombre').textContent = btn.dataset.nombre;
        document.getElementById('formDelete').action = '/Telefonos/Delete/' + btn.dataset.id;
    });

    // ── Utilidad: muestra errores de validación en el formulario ──────────────
    function mostrarErrores(errores, prefijo) {
        Object.keys(errores).forEach(function (campo) {
            var el = document.getElementById(prefijo + 'Error' + campo);
            if (el) el.textContent = errores[campo];
        });
    }

    function limpiarErrores(formularioId) {
        document.querySelectorAll('#' + formularioId + ' .text-danger').forEach(function (el) {
            el.textContent = '';
        });
    }

    // ── AJAX: Crear teléfono ──────────────────────────────────────────────────
    document.getElementById('formAddTelefono').addEventListener('submit', async function (e) {
        e.preventDefault();
        limpiarErrores('formAddTelefono');

        const formData = new FormData(this);
        const response = await fetch(this.action, { method: 'POST', body: formData });
        const result = await response.json();

        if (result.success) {
            location.reload();
        } else {
            mostrarErrores(result.errors, 'add');
        }
    });

    // ── AJAX: Editar teléfono ─────────────────────────────────────────────────
    // Poblar el modal con los datos del registro al hacer clic en Editar
    var editModal = document.getElementById('editTelefonoModal');
    editModal.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('editId').value              = btn.dataset.id;
        document.getElementById('editNombreDueno').value     = btn.dataset.nombre;
        document.getElementById('editNumeroTelefono').value  = btn.dataset.numero;
        document.getElementById('editDescripcion').value     = btn.dataset.descripcion ?? '';
        limpiarErrores('formEditTelefono');
    });

    document.getElementById('formEditTelefono').addEventListener('submit', async function (e) {
        e.preventDefault();
        limpiarErrores('formEditTelefono');

        var id = document.getElementById('editId').value;
        var formData = new FormData(this);
        // La acción del formulario apunta a /Telefonos/Edit; añadimos el id en la URL
        var response = await fetch('/Telefonos/Edit/' + id, { method: 'POST', body: formData });
        var result = await response.json();

        if (result.success) {
            location.reload();
        } else {
            mostrarErrores(result.errors, 'edit');
        }
    });
</script>
}